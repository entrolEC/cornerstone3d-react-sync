{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": { "react-cornerstone3d": ["./src/index.ts"] },
    "declaration": true,
    "outDir": "dist",
    "noEmit": true
  },
  "include": ["src", "demo"],
  // vite.config.ts runs under Node, not in this typecheck — no @types/node needed.
  "exclude": ["demo/vite.config.ts"]
}
